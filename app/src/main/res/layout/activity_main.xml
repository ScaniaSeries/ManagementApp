<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F3EF"
    android:padding="20dp">

    <!--bagian header : sapaan-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="24dp">

        <!--elemen view-->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selamat Datang,"
            android:textSize="14sp"
            android:textColor="#2D2A26" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvNamaSiswa"
            android:text="Rafasya kelas XII RPL 2"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D3436" />

    </LinearLayout>

    <!--Bagian kartu Ringkasan-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <!--kotak 1: info tugas-->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tugas Pending"
                android:textSize="12sp"
                android:textColor="#636E72" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvJumlahTugas"
                android:text="3"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#D63031"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!--kotak 2 info nilai-->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginStart="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rata-rata Nilai"
                android:textSize="12sp"
                android:textColor="#636E72" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/tvRataNilai"
                android:text="88,5"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#00B894"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </LinearLayout>
    <!--bagian judul : daftar tugas terbaru-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tugas terbaru"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#2D3436"
        android:layout_marginBottom="12dp"/>
    <!--placeholder sementara card tugas-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="object orientation programming (OOP)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#2D3436"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buat Program CRUD sederhana"
            android:textSize="12sp"
            android:textColor="#636E71"
            android:layout_marginTop="4dp">

        </TextView>

    </LinearLayout>

</LinearLayout>
